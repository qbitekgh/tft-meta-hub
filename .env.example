# Copy this file to .env and fill in your own values. .env is git-ignored and never put into an image.

# Riot development key from https://developer.riotgames.com (expires every 24 hours).
# Only needed for collecting matches; the rest of the application works without it.
RIOT_API_KEY=RGAPI-your-development-key

# The only user: the admin who manages tier lists, imports game data and starts the collector.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional: database settings (these defaults match compose.yaml).
# DB_NAME=tftmetahub
# DB_USERNAME=tftmetahub
# DB_PASSWORD=tftmetahub
